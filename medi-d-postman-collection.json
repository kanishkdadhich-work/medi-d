  "item": [
    {
      "name": "1. Health Check",
      "item": [
        {
          "name": "Check API Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is running message\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"Medi-D System is up and running\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Check if the Medi-D API is up and running"
          },
          "response": []
        }
      ]
    },
