    {
      "name": "👨‍💼 RECEPTIONIST ENDPOINTS (Any Authenticated User Can Access)",
      "item": [
        {
          "name": "Register Patient (ANY AUTH)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{receptionist_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Smith\",\n  \"contact\": \"+1-555-0100\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/patients",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "patients"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "console.log('Response Code: ' + pm.response.code);",
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('patient_id', jsonData.id);",
                  "    console.log('✅ Patient created with ID: ' + jsonData.id);",
                  "} else {",
                  "    console.log('❌ Failed: ' + pm.response.code);",
                  "    console.log(pm.response.text());",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Patient (ANY AUTH)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{receptionist_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/patients/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "patients", "1"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
