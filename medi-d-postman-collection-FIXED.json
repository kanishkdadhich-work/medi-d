    {
      "name": "🔒 SECURITY & ROLE TESTS",
      "item": [
        {
          "name": "❌ Test: Pharmacist Cannot Access Doctor Endpoints",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacist_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/appointments/patient/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "appointments", "patient", "1"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Pharmacist should be forbidden (403)', function() {",
                  "  pm.expect(pm.response.code).to.equal(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "❌ Test: Doctor Cannot Access Pharmacy Endpoints",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doctor_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/pharmacy/prescriptions/pending",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "pharmacy", "prescriptions", "pending"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Doctor should be forbidden (403)', function() {",
                  "  pm.expect(pm.response.code).to.equal(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "❌ Test: No Token Gives Unauthorized",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/patients/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "patients", "1"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('No token should give 401/403', function() {",
                  "  pm.expect([401, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "❌ Test: Invalid Token Gives Error",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer invalid.token.here"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/patients/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "patients", "1"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invalid token should give error', function() {",
                  "  pm.expect([401, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
