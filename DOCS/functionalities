GET /api/appointments/patient/{patientId} – list by patient
GET /api/appointments/doctor/{doctorId} – list by doctor
GET /api/appointments/search/between – time range
GET /api/appointments/booked/{doctorId} – booked slots
GET /api/appointments/check-slot – slot availability
GET /api/appointments/by-status/{status} – by status
DELETE /api/appointments/{id} – delete
Medicines
GET /api/medicines/{id} – get by ID
GET /api/medicines/search/by-name – get by name
POST /api/medicines – create
PUT /api/medicines/{id} – update
GET /api/medicines/expiring-before – expiring before date
GET /api/medicines/low-stock – low stock
GET /api/medicines/search – search by pattern
DELETE /api/medicines/{id} – delete
Prescriptions
GET /api/prescriptions/{id} – get by ID
GET /api/prescriptions/appointment/{appointmentId} – get by appointment
POST /api/prescriptions – create
PUT /api/prescriptions/{id} – update
GET /api/prescriptions/by-status/{status} – by status
GET /api/prescriptions/pending – pending
GET /api/prescriptions/dispensed – dispensed
GET /api/prescriptions/patient/{patientId} – by patient
GET /api/prescriptions/patient/{patientId}/pending-count – pending count
POST /api/prescriptions/{id}/dispense – dispense (reduce stock)
